# Capacities, quanta and costs are Integers in 1..2**32-1: TypeError for
# anything else, RangeError outside the range, zero included. Hashes are
# Integers in 0..2**64-1; tenant and lane positions and lane counts are
# Integers a `usize` holds (0..2**64-1 on a 64-bit platform, 0..2**32-1 on a
# 32-bit one): TypeError for anything else, RangeError outside the range.
# Every message names the offending argument. Arguments are positional, in
# the core's order. Nothing here takes time, so no answer records a clock. A
# frozen object raises FrozenError on every mutating call. Refusals are
# symbols, one per core `Refusal` variant; they never raise, and a refused
# call changes nothing.
module FairMachines
  VERSION: String

  # The core's `Refusal`.
  # :unknown_tenant, the tenant index is not one of the scheduler's tenants.
  # :unknown_lane, the lane is not one of this instance's lanes.
  # :insufficient, more cost asked for than the budget has available.
  # :exceeds_in_flight, more cost returned than the budget has admitted.
  type refusal = :unknown_tenant | :unknown_lane | :insufficient | :exceeds_in_flight

  # The core's `Lane`: the bucket a hash maps to. A position, not an issued
  # id: it can be built freely and proves nothing. Like the core's
  # `Lane::new(index)`, it holds only a position: `index` is an Integer a
  # `usize` holds, TypeError for anything else, RangeError outside the range.
  # Sealed: subclassing raises TypeError and `allocate` is undefined. Every
  # Lane the binding reads must be an instance of exactly this class
  # (TypeError otherwise) and its index is re-checked (RangeError), so a
  # value forged by reflection or Marshal never reaches the core.
  class Lane < Data
    attr_reader index: Integer
    def self.new: (Integer index) -> Lane
                | (index: Integer) -> Lane
  end

  # The core's `TenantFair<N>`; `N` is the length of the arrays.
  class TenantFair
    # The largest `N` compiled into this binding: `TenantFair<1>` to
    # `TenantFair<16>`. The core takes any `N`; it has no ceiling of its own.
    MAX_TENANTS: Integer

    # The core's `TenantFair::new(capacities, quanta)`. `N` is the arrays'
    # length: raises RangeError unless both have the same length, in
    # 1..MAX_TENANTS, and TypeError unless both are Arrays.
    def self.new: (Array[Integer] capacities, Array[Integer] quanta) -> TenantFair

    # Honoured: :admitted. Refused: :unknown_tenant, :insufficient.
    def admit: (Integer tenant, Integer cost) -> (:admitted | :unknown_tenant | :insufficient)

    # Honoured: :cancelled. Refused: :unknown_tenant, :exceeds_in_flight.
    # A repeat cannot be recognised: it is honoured while that much cost is
    # still admitted and refused once it is not.
    def cancel: (Integer tenant, Integer cost) -> (:cancelled | :unknown_tenant | :exceeds_in_flight)

    # `heads` has one entry per tenant: the cost at the head of its queue,
    # nil when it has nothing waiting. Honoured: the tenant to dispatch, or
    # nil exactly when every head is nil. Refused: :exceeds_in_flight, some
    # head costs more than its tenant has admitted. Raises RangeError
    # unless `heads` has tenant_count entries.
    def select: (Array[Integer?] heads) -> (Integer | nil | :exceeds_in_flight)

    def tenant_count: () -> Integer

    # Cost admitted and not yet dispatched or cancelled; nil for an index
    # that is not a tenant. A query.
    def in_flight: (Integer tenant) -> Integer?

    # Cost the tenant may still admit; nil for an index that is not a tenant.
    def available: (Integer tenant) -> Integer?
  end

  # The core's `KeyedFair<LANES>`. `LANES` is a const generic in the core;
  # here it is the first argument wherever the core names the type.
  class KeyedFair
    # The largest `LANES` compiled into this binding: `KeyedFair<1>` to
    # `KeyedFair<256>`. The core takes any `LANES > 0`; it has no ceiling of
    # its own.
    MAX_LANES: Integer

    # The core's `KeyedFair::<LANES>::new(capacity)`. Raises RangeError
    # unless `lanes` is in 1..MAX_LANES.
    def self.new: (Integer lanes, Integer capacity) -> KeyedFair

    # The core's associated `KeyedFair::<LANES>::lane(hash)`: the lane a hash
    # maps to. A pure function. Raises RangeError unless `lanes` is in
    # 1..MAX_LANES.
    def self.lane: (Integer lanes, Integer hash) -> Lane

    # The core's associated `KeyedFair::<LANES>::lane_at(index)`: nil for an
    # index of `lanes` or more. Raises RangeError unless `lanes` is in
    # 1..MAX_LANES.
    def self.lane_at: (Integer lanes, Integer index) -> Lane?

    # Honoured: the Lane that was charged. Refused: :insufficient. The Lane
    # is built through `Lane.new` before the admission is kept: if that
    # raises, freezes this KeyedFair (FrozenError) or changes it
    # (RuntimeError), nothing is admitted.
    def admit: (Integer hash, Integer cost) -> (Lane | :insufficient)

    # Honoured: :released. Refused: :unknown_lane, :exceeds_in_flight. A
    # repeat cannot be recognised: it is honoured while that much cost is
    # still in flight and refused once it is not. Raises TypeError unless
    # given a Lane.
    def release: (Lane lane, Integer cost) -> (:released | :unknown_lane | :exceeds_in_flight)

    def lane_count: () -> Integer

    # Cost admitted to the lane and not yet released; nil for a lane this
    # instance does not have. Raises TypeError unless given a Lane.
    def in_flight: (Lane lane) -> Integer?

    # Cost the lane may still admit; nil for a lane this instance does not have.
    def available: (Lane lane) -> Integer?
  end
end
